# Preflight: ./demo/setup.sh.
Output demo/recordings/safeselect-docker.gif

Require docker

Set Shell "bash"
Set FontSize 22
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Frappe"
Set TypingSpeed 20ms
Set WindowBar "Colorful"

Type "cd /Users/antonillos/Projects/antonillos/safeselect"
Enter
Type "./demo/verify.sh"
Enter
Sleep 5s
